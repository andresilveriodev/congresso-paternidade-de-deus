BREVO_API_KEY=coloque_sua_chave_brevo_aqui
BREVO_SENDER_NAME=Congresso Pai Eterno
BREVO_SENDER_EMAIL=inscricoes@congressopaieterno.com.br

INSCRICAO_EMAIL_DESTINO=inscricoes@congressopaieterno.com.br
INSCRICAO_EMAIL_COPIA=congressopaternidadededeus@gmail.com
INSCRICAO_EMAIL_BACKUP=congressopaternidadededeus@gmail.com

NEXT_PUBLIC_HOTMART_CHECKOUT_URL=https://pay.hotmart.com/J106565086L?off=kxryq3he&checkoutMode=10

# Exibicao publica da area de videos: trocar para true quando os videos estiverem prontos.
NEXT_PUBLIC_CONGRESS_VIDEOS_ENABLED=false

# Integracoes da galeria do Congresso (somente no servidor).
# Cole apenas o ID da pasta; mantenha a pasta restrita e compartilhe com a conta de servico como Leitor.
GOOGLE_DRIVE_FOLDER_ID=
# JSON completo da conta de servico em uma unica linha; nunca versionar credenciais reais.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID apos list= no link da playlist publica. O player acompanha essa playlist diretamente.
YOUTUBE_PLAYLIST_ID=
# Padrao: playlist. Independe de API key, mesmo que uma chave esteja preenchida.
YOUTUBE_DISPLAY_MODE=playlist
# Somente para o modo opcional cards, que precisa ser ativado explicitamente.
YOUTUBE_API_KEY=

# Painel de envio: /admin/galeria. Gere o acesso com npm run galeria:painel.
GALLERY_ADMIN_PASSWORD_HASH=
GALLERY_SESSION_SECRET=
# Produção: conectar um armazenamento Blob PRIVADO ao projeto na Vercel.
BLOB_READ_WRITE_TOKEN=
# Somente nos testes locais: local. Em produção, deixar vazio.
GALLERY_STORAGE=
